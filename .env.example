# Server
PORT=3000
NODE_ENV=development

# Auth (required in production — never commit .env)
SESSION_SECRET=generate-a-long-random-string
JWT_SECRET=generate-another-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-password-here
COOKIE_SECURE=false

# Internal agents / n8n → Hub API (header: X-API-Key)
INTERNAL_API_KEY=generate-internal-api-key

# Agent hub URL (server-side only)
HUB_URL=http://localhost:3000

# Redis (BullMQ queues — required for worker processes)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional integrations (server-side only)
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678
SERPAPI_KEY=

# Scraping proxy (optional — used by stealth fetcher)
SCRAPER_API_KEY=
SCRAPER_API_URL=https://api.scrapingbee.com/v1

# Session tokens for authenticated platform scraping (semicolon-separated)
LINKEDIN_SESSIONS=
INDEED_SESSIONS=
GLASSDOOR_SESSIONS=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Dev only: allow default secrets when NODE_ENV=development
# ALLOW_DEV_DEFAULTS=true
